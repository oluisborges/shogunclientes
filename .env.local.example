# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Meta Ads API
# Tokens are stored per-client in the database, not here
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
NEXT_PUBLIC_META_APP_ID=your_meta_app_id

# Google Sheets / Drive
# Service Account com acesso à pasta do Drive
GOOGLE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# ID da pasta do Google Drive que contém as planilhas dos clientes
# (ex: https://drive.google.com/drive/folders/FOLDER_ID)
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id

# Google Calendar
# ID do calendário "Reuniões - Grupo Shogun"
# Compartilhe o calendário com GOOGLE_CLIENT_EMAIL (permissão: "Fazer alterações em eventos")
GOOGLE_CALENDAR_ID=629e99e9290f64bc2cfee442d316645f942f4db76911c300904c822e192658e9@group.calendar.google.com
# ID ou e-mail do calendário usado para verificar disponibilidade (freebusy)
# Use o calendário "Samurai do Trafego" (leandrosamurait@gmail.com)
# Compartilhe com GOOGLE_CLIENT_EMAIL (permissão: "Ver todos os detalhes dos eventos")
GOOGLE_FREEBUSY_CALENDAR_ID=leandrosamurait@gmail.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
